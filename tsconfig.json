{
  // Type checking for the plain-JS frontend (#331). There is no build step:
  // tsc runs with noEmit against the .js files exactly as they ship. Only
  // files that opt in with a // @ts-check comment are checked (checkJs is
  // off); the rest are still loaded so their script-scope globals resolve.
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "target": "es2020",
    "lib": ["es2020", "dom", "dom.iterable"],
    "strict": false,
    "noImplicitAny": false,
    // globals.d.ts imports @supabase/supabase-js (type-only, #331) purely to
    // type window.supabase against the generated schema; skipLibCheck keeps
    // tsc from also type-checking that package's own .d.ts internals (and
    // its transitive Node-oriented types we don't use, e.g. storage-js'
    // Buffer/NodeJS references) against this browser-only lib set.
    "skipLibCheck": true
  },
  "include": ["js/**/*.js", "js/globals.d.ts", "js/database.types.ts"]
}
