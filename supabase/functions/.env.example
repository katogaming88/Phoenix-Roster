# WarcraftLogs OAuth app credentials (#223). Same secrets already configured
# in Project Settings > Edge Functions > Secrets for the deployed function
# (per #205) -- this file is only for local `supabase functions serve`.
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# Discord native incoming webhook for the BoE Found channel (#746). Unset
# means boe-webhook no-ops with { skipped: true } -- safe to leave blank.
BOE_WEBHOOK_URL=
